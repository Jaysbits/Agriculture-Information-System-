# =====================================================================
# AgriSys environment settings
# Copy this file to ".env" and fill in your Supabase values.
# NEVER commit .env — it contains the database password.
# =====================================================================

# --- Supabase PostgreSQL ---------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string
#
# Use the **Session pooler** (port 5432) or the direct connection.
# The transaction pooler (port 6543) is not recommended because the
# application uses session settings and prepared statements.
#
# Session pooler example:
#   host: aws-0-ap-southeast-1.pooler.supabase.com
#   user: postgres.abcdefghijklmnop
DB_HOST=your-project-ref.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_SSLMODE=require

# --- Application -----------------------------------------------------
# Leave APP_BASE_URL empty when the site is served from the domain root
# (e.g. "php -S localhost:8000 -t public"). Set it to "/ap3" if you
# deploy under a sub-folder.
APP_BASE_URL=
APP_TIMEZONE=Asia/Manila
ITEMS_PER_PAGE=10
